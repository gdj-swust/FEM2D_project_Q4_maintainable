# 缓存与构建产物
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.venv*/
*.egg-info/
build/
dist/

# 第三方工具 (86MB gmsh.exe — 需用时手动复制, 不入库)
tools/

# 运行产物
models/tmp*
models/*.msh
scripts/convergence/*.msh

# 派发任务文件 (任务完成后是派发记录, 不入库)
PROMPT*.md

# 分包 worktree (git 已管理, 避免 add -A 误跟踪)
wt_*/

# 生成 PDF (tex 源已在库)
architecture.pdf
scripts/convergence/
perf_results.json

# GUI/Wizard 运行时临时几何 (随机后缀, 不入库)
.fem2d-*

# LaTeX 编译产物
FEM2D_USER_GUIDE.aux
FEM2D_USER_GUIDE.log
FEM2D_USER_GUIDE.out
FEM2D_USER_GUIDE.toc
