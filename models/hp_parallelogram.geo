// 平行四边形(非90°) + 圆孔 + 三角孔 + 方孔
lc = 0.12; n=20;

// 外边: 平行四边形 (非90°)
Point(1) = {0, 0, 0, lc};
Point(2) = {8, 0, 0, lc};
Point(3) = {10, 5, 0, lc};
Point(4) = {2, 5, 0, lc};
Line(1) = {1, 2};
Line(2) = {2, 3};
Line(3) = {3, 4};
Line(4) = {4, 1};
Curve Loop(100) = {1, 2, 3, 4};

// 圆孔 R=0.6 @ (3, 2.5)
Point(10) = {3, 2.5, 0, lc*0.4};
For i In {0:n-1}
  ang = 2*Pi*i/n;
  Point(200+i) = {3+0.6*Cos(ang), 2.5+0.6*Sin(ang), 0, lc*0.4};
EndFor
For i In {0:n-1}
  Circle(300+i) = {200+i, 10, 200+((i+1)%n)};
EndFor
Curve Loop(301) = {300:319};

// 三角孔 side=1.0 @ (7, 1.5)
Point(400) = {7, 2.3, 0, lc*0.3};
Point(401) = {6.15, 0.8, 0, lc*0.3};
Point(402) = {7.85, 0.8, 0, lc*0.3};
Line(410) = {400, 401};
Line(411) = {401, 402};
Line(412) = {402, 400};
Curve Loop(302) = {410, 411, 412};

// 方孔 0.7x0.7 @ (5, 3.5)
Point(500) = {4.65, 3.15, 0, lc*0.3};
Point(501) = {5.35, 3.15, 0, lc*0.3};
Point(502) = {5.35, 3.85, 0, lc*0.3};
Point(503) = {4.65, 3.85, 0, lc*0.3};
Line(510) = {500, 501};
Line(511) = {501, 502};
Line(512) = {502, 503};
Line(513) = {503, 500};
Curve Loop(303) = {510, 511, 512, 513};

Plane Surface(1) = {100, 301, 302, 303};
Mesh.SaveAll = 1;
Mesh.Format = 39;
Mesh 2;
Save "hp_parallelogram.msh";
