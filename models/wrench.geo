// 扳手 — 开口头部 + 直柄连接
// 头部左半圆 (θ∈[120°, 240°] 约 120° 弧) + 上下过渡 + 矩形手柄
//     固定(左弧)
//    ╭──────╮
//   ╭┤  ○   ├──────────┐
//   │╰──────╯  shaft    │ ← 力
//   ╰───────────────────╯

lc = 0.8;
n_half = 20;   // 头部圆弧段数 (覆盖约 180°)

// ── 头部弧: 从上到下经过左边, R=25 ──
// 弧起点 θ≈150° (左上), 终点 θ≈210° (左下)
// cos(150°)=-21.65, sin(150°)=12.5
// cos(210°)=-21.65, sin(210°)=-12.5
Point(1)  = { -21.65,  12.5, 0, lc*0.5}; // 弧起点 左上
Point(2)  = {  24.0,   10.0, 0, lc};      // 手柄左上
Point(3)  = { 110.0,   10.0, 0, lc};      // 手柄右上
Point(4)  = { 110.0,  -10.0, 0, lc};      // 手柄右下
Point(5)  = {  24.0,  -10.0, 0, lc};      // 手柄左下
Point(6)  = { -21.65, -12.5, 0, lc*0.5}; // 弧终点 左下

// 头部弧中间点 (均匀分布在左半圆: θ=150°→180°→210°)
// 但 Gmsh 的 Circle 需要 <180°, 所以分两段
Point(10) = { 0, 0, 0, lc*0.3};           // 圆心
Point(11) = { -25, 0, 0, lc*0.3};         // 弧中点 (最左端, θ=180°)

// 弧1: 左上→最左 (θ=150°→180°, 30°弧)
Circle(1) = {1, 10, 11};
// 弧2: 最左→左下 (θ=180°→210°, 30°弧)
Circle(2) = {11, 10, 6};

// ── 直边 ──
Line(3) = {6, 5};    // 左下→手柄下
Line(4) = {5, 4};    // 手柄下面
Line(5) = {4, 3};    // 手柄右端 → 受力边
Line(6) = {3, 2};    // 手柄上面
Line(7) = {2, 1};    // 手柄上→左上

// ── 螺栓孔: R=8 @ (0,0) ──
n_hole = 24;
R_hole = 8.0;
For i In {0:n_hole-1}
  ang = 2*Pi*i/n_hole;
  Point(100 + i) = { R_hole*Cos(ang), R_hole*Sin(ang), 0, lc*0.3};
EndFor
Point(199) = {0, 0, 0, lc*0.2};

For i In {0:n_hole-1}
  Line(200 + i) = { 100+((i+1)%n_hole), 100+i };
EndFor

// ── 面 ──
Curve Loop(300) = {1, 2, 3, 4, 5, 6, 7};
Curve Loop(301) = { 200:200+n_hole-1 };
Plane Surface(1) = {300, 301};

// ── Physical Groups ──
Physical Surface("domain", 200) = {1};
Physical Curve("头部_固定", 101) = {1, 2};
Physical Curve("手柄端",   102) = {5};

// @FEM:fix=头部_固定
// @FEM:traction=手柄端,0,-3e6

Mesh.Format = 39;
Mesh.SaveAll = 1;
Mesh 2;
Save "wrench.msh";
