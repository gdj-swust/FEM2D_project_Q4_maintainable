// 椭圆外边 + 10个随机孔(圆/方/三角混合)
lc = 0.15;

Point(1) = {0, 0, 0, lc*0.5};
Point(100) = {6, 0, 0, lc};
Point(101) = {0, 4, 0, lc};
Point(102) = {-6, 0, 0, lc};
Point(103) = {0, -4, 0, lc};
Ellipse(200) = {100, 1, 100, 101};
Ellipse(201) = {101, 1, 100, 102};
Ellipse(202) = {102, 1, 100, 103};
Ellipse(203) = {103, 1, 100, 100};
Curve Loop(300) = {200, 201, 202, 203};

// 孔1: 圆 R=0.47 @ (1.22, 1.88)
Point(400) = {1.22, 1.88, 0, lc*0.3};
For i In {0:15}
  ang = 2*Pi*i/16;
  Point(500+i) = {1.22+0.47*Cos(ang), 1.88+0.47*Sin(ang), 0, lc*0.3};
EndFor
For i In {0:15}
  Circle(600+i) = {500+i, 400, 500+((i+1)%16)};
EndFor
Curve Loop(700) = {600:615};

// 孔2: 方 @ (-2.19, 1.45) size=0.359
Point(701) = {-2.37, 1.27, 0, lc*0.3};
Point(702) = {-2.01, 1.27, 0, lc*0.3};
Point(703) = {-2.01, 1.63, 0, lc*0.3};
Point(704) = {-2.37, 1.63, 0, lc*0.3};
Line(710) = {701,702}; Line(711) = {702,703};
Line(712) = {703,704}; Line(713) = {704,701};
Curve Loop(701) = {710,711,712,713};

// 孔3: 三角 @ (-3.44, -0.84) size=0.48
// 修复: 原位置 (-3.24, -0.84) 的顶点 (-2.74,-1.10) 距孔8圆心
// (-2.35,-0.86) 仅 0.458 < 0.53, 两孔重叠导致面网格失败 (1D 网格自交)。
// 左移 0.2 后最近距离 0.637, 且仍在椭圆域内。
Point(720) = {-3.44, -0.68, 0, lc*0.3};
Point(721) = {-3.94, -1.10, 0, lc*0.3};
Point(722) = {-2.94, -1.10, 0, lc*0.3};
Line(720) = {720,721}; Line(721) = {721,722}; Line(722) = {722,720};
Curve Loop(702) = {720,721,722};

// 孔4: 圆 R=0.28 @ (-3.17, 2.06)
Point(730) = {-3.17, 2.06, 0, lc*0.3};
For i In {0:15}
  ang = 2*Pi*i/16;
  Point(740+i) = {-3.17+0.28*Cos(ang), 2.06+0.28*Sin(ang), 0, lc*0.3};
EndFor
For i In {0:15}
  Circle(760+i) = {740+i, 730, 740+((i+1)%16)};
EndFor
Curve Loop(703) = {760:775};

// 孔5: 方 @ (1.07, -0.88) size=0.32
Point(770) = {0.91, -1.04, 0, lc*0.3};
Point(771) = {1.23, -1.04, 0, lc*0.3};
Point(772) = {1.23, -0.72, 0, lc*0.3};
Point(773) = {0.91, -0.72, 0, lc*0.3};
Line(1000) = {770,771}; Line(1001) = {771,772};
Line(1002) = {772,773}; Line(1003) = {773,770};
Curve Loop(704) = {1000,1001,1002,1003};

// 孔6: 三角 @ (0.44, -2.47) size=0.57
Point(780) = {0.44, -2.14, 0, lc*0.3};
Point(781) = {-0.15, -2.72, 0, lc*0.3};
Point(782) = {1.03, -2.72, 0, lc*0.3};
Line(1010) = {780,781}; Line(1011) = {781,782}; Line(1012) = {782,780};
Curve Loop(705) = {1010,1011,1012};

// 孔7: 圆 R=0.25 @ (2.90, 1.67)
Point(790) = {2.90, 1.67, 0, lc*0.3};
For i In {0:15}
  ang = 2*Pi*i/16;
  Point(800+i) = {2.90+0.25*Cos(ang), 1.67+0.25*Sin(ang), 0, lc*0.3};
EndFor
For i In {0:15}
  Circle(820+i) = {800+i, 790, 800+((i+1)%16)};
EndFor
Curve Loop(706) = {820:835};

// 孔8: 圆 R=0.53 @ (-2.35, -0.86)
Point(840) = {-2.35, -0.86, 0, lc*0.3};
For i In {0:15}
  ang = 2*Pi*i/16;
  Point(850+i) = {-2.35+0.53*Cos(ang), -0.86+0.53*Sin(ang), 0, lc*0.3};
EndFor
For i In {0:15}
  Circle(870+i) = {850+i, 840, 850+((i+1)%16)};
EndFor
Curve Loop(707) = {870:885};

// 孔9: 方 @ (-0.43, -0.99) size=0.40
Point(880) = {-0.63, -1.19, 0, lc*0.3};
Point(881) = {-0.23, -1.19, 0, lc*0.3};
Point(882) = {-0.23, -0.79, 0, lc*0.3};
Point(883) = {-0.63, -0.79, 0, lc*0.3};
Line(1020) = {880,881}; Line(1021) = {881,882};
Line(1022) = {882,883}; Line(1023) = {883,880};
Curve Loop(708) = {1020,1021,1022,1023};

// 孔10: 三角 @ (3.63, -0.48) size=0.37
Point(890) = {3.63, -0.27, 0, lc*0.3};
Point(891) = {3.24, -0.68, 0, lc*0.3};
Point(892) = {4.02, -0.68, 0, lc*0.3};
Line(1030) = {890,891}; Line(1031) = {891,892}; Line(1032) = {892,890};
Curve Loop(709) = {1030,1031,1032};

Plane Surface(1) = {300, 700, 701, 702, 703, 704, 705, 706, 707, 708, 709};
Physical Curve("outer_ellipse") = {200, 201, 202, 203};
Physical Curve("hole_1") = {600:615};
Physical Curve("hole_2") = {710:713};
Physical Curve("hole_3") = {720:722};
Physical Curve("hole_4") = {760:775};
Physical Curve("hole_5") = {1000:1003};
Physical Curve("hole_6") = {1010:1012};
Physical Curve("hole_7") = {820:835};
Physical Curve("hole_8") = {870:885};
Physical Curve("hole_9") = {1020:1023};
Physical Curve("hole_10") = {1030:1032};
Physical Surface("domain") = {1};
Mesh.SaveAll = 1;
Mesh.Format = 39;
Mesh 2;
Save "hp_ellipse_10holes.msh";
