// 复杂几何: 圆角矩形 + 椭圆孔 + 半圆凹口
lc = 0.03;

// ═══════════════════════════════════════════════
// 外边界 — 圆角矩形 4.0×3.0, 圆角R=0.3
// 底边带半圆凹口 R=0.35, 位置x≈0.8 (两个90°弧, Gmsh要求<180°)
// ═══════════════════════════════════════════════
W = 2.0;  H = 1.5;  FR = 0.3;

// ─ 底边: 分三段 (左直线 + 半圆凹弧×2 + 右直线) ─
aR = 0.35;  ax = 0.8;  // 凹弧半径, 弧心x坐标
// 左下角圆角终点
Point(1)  = { -W+FR, -H,      0, lc};
// 凹弧左端点 (在底边上)
Point(2)  = { ax-aR,  -H,      0, lc};
// 凹弧右端点 (在底边上)
Point(3)  = { ax+aR,  -H,      0, lc};
// 凹弧圆心 (在底边上 → 半圆向上凹入板内, R=aR=0.35)
Point(4)  = { ax,     -H,      0, lc};
// 凹弧顶点 (半圆最高点, 拆分180°弧为两个90°弧)
Point(17) = { ax,     -H+aR,   0, lc};
// 右下圆角起点
Point(5)  = { W-FR,  -H,       0, lc};

// 底边直线段
Line(1) = {1, 2};
// 凹弧左半段 (圆心(4), 从(2)到顶点(17), Gmsh要求<180°)
Circle(2) = {2, 4, 17};
// 凹弧右半段 (圆心(4), 从顶点(17)到(3))
Circle(11) = {17, 4, 3};
// 底边继续
Line(3) = {3, 5};

// ─ 右下圆角 ─
Point(6)  = { W,     -H+FR,   0, lc};
Point(7)  = { W-FR,  -H+FR,   0, lc};
Circle(4) = {5, 7, 6};

// ─ 右边 ─
Point(8)  = { W,      H-FR,   0, lc};
Line(5)   = {6, 8};

// ─ 右上圆角 ─
Point(9)  = { W-FR,   H,      0, lc};
Point(10) = { W-FR,   H-FR,   0, lc};
Circle(6) = {8, 10, 9};

// ─ 顶边 ─
Point(11) = { -W+FR,  H,      0, lc};
Line(7)   = {9, 11};

// ─ 左上圆角 ─
Point(12) = { -W,     H-FR,   0, lc};
Point(13) = { -W+FR,  H-FR,   0, lc};
Circle(8) = {11, 13, 12};

// ─ 左边 ─
Point(14) = { -W,    -H+FR,   0, lc};
Line(9)   = {12, 14};

// ─ 左下圆角 ─ (终点=Point(1), 闭合)
Point(16) = { -W+FR,  -H+FR,   0, lc};
Circle(10) = {14, 16, 1};

// 外边界闭环
Curve Loop(100) = { 1, 2, 11, 3, 4, 5, 6, 7, 8, 9, 10 };


// ═══════════════════════════════════════════════
// 椭圆孔: a=0.4, b=0.2, 中心(0.3, 0.15)
// ═══════════════════════════════════════════════
cx1 = 0.3;  cy1 = 0.15;  a1 = 0.4;  b1 = 0.2;  n1 = 20;
For i In {0:n1-1}
  ang = 2*Pi*i/n1;
  Point(200 + i) = { cx1 + a1*Cos(ang), cy1 + b1*Sin(ang), 0, lc};
EndFor
For i In {0:n1-1}
  Line(300 + i) = { 200 + i, 200 + ((i+1)%n1) };
EndFor
Curve Loop(301) = { 300:300+n1-1 };


// ═══════════════════════════════════════════════
// Plane Surface + 网格 + 输出
// ═══════════════════════════════════════════════
Plane Surface(1) = { 100, 301 };

// (手动选边模式 — 运行时选边界编号)

Physical Surface("domain", 200) = {1};
Physical Curve("left",  101) = {9};
Physical Curve("right", 102) = {5};
Physical Curve("底部",103) = {1,3};
Physical Curve("顶部",104) = {7};
Physical Curve("凹弧",107) = {2, 11};
Physical Curve("右下圆角",108) = {4};
Physical Curve("右上圆角",109) = {6};
Physical Curve("左上圆角",110) = {8};
Physical Curve("左下圆角",111) = {10};
Physical Curve("椭圆孔",112) = {300:319};

Mesh.Format = 39;
Mesh.SaveAll = 1;
Recombine Surface{1};
Mesh 2;
Save "demo_complex.msh";
